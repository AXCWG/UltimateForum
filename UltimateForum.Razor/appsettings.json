{
  "$desc": "AppConfigDir should always be set to the appsettings.json related to your executable. ",
  "AppConfigDir": "appsettings.json",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DbType": "sqlite",
  "ConnectionStrings": {
    "MySqlConnection": "server=localhost;port=3306;database=ultimate_forum;user=root;password=your_password;",
    "SqliteConnection": "Data Source=data/data.db",
    "BinaryConnection": "Data Source=data/binary.db"
  },
  "ForumName": "Ultimate Forum",
  "ForumNameIndexWelcomePhrase": "\u6B22\u8FCE\u6765\u5230 {{ForumName}}\uFF01",
  "ForumDescription": "\u529F\u80FD\u5341\u5206\u5F3A\u5927\u7684\u8BBA\u575B\u5F15\u64CE",
  "ForumIcon": "~/assets/forum.jpg",
  "UseBoardCreation": "True",
  "AllowUserCreateBoard": "True",
  "AllowAnonymousPost": "True",
  "AllowAnonymousTopic": "True",
  "AllowAnonymousBoard": "True",
  "ShowButtonWhenFeatureDisabled": "True"
}