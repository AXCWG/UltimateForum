@page
@using AXHelper.Extensions
@model UltimateForum.Razor.Pages.Dashboard
@{ ViewData["Title"] = "设置页";}

<div class="container">
    <div class="row">
        <div class="col-sm-6 col-md-4 p-1 d-flex flex-column gap-2">
            <div class="card p-3 bg-dark-subtle">
                <h2 class="fw-lighter">基本信息</h2>
                <div>
                    <form method="post">
                        <img src="~/assets/forum.jpg" alt="forum-icon"/><br/>
                        <span asp-validation-for="@Model.NewName" class="text-danger mt-2"></span>
                        <div class="mt-2 d-flex flex-column gap-2">
                            <span style="font-weight: 1">网站名称：</span><input id="new-name" class="form-control m-0" value="@Model.Config["ForumName"]" asp-for="NewName"/>
                            <span style="font-weight: 1">已注册用户：@Model.UserCount()</span>
                            <span style="font-weight: 1">话题数：@Model.TopicCount()</span>
                            <span style="font-weight: 1">回复数：@Model.PostCount()</span>
                            <button class="btn btn-primary" asp-page-handler="EditName" type="submit">保存</button>

                        </div>
                        
                    </form>
                    
                </div>
            </div>
            <div class="card p-3 bg-dark-subtle">
                <div>
                    <h2 class="fw-lighter">主页</h2>
                    <form method="post">
                        <span asp-validation-for="@Model.ForumNameIndexWelcomePhrase" class="text-danger mt-2"></span>
                        <label for="forum-welcome-phrase">欢迎语</label>
                        <input id="forum-welcome-phrase" class="form-control" asp-for="ForumNameIndexWelcomePhrase" value="@Model.Config["ForumNameIndexWelcomePhrase"]"/>
                        <span asp-validation-for="@Model.ForumDescription" class="text-danger mt-2"></span>
                        <label for="forum-desc-input">介绍文</label>
                        <input id="forum-desc-input" class="form-control" asp-for="@Model.ForumDescription" value="@Model.Config["ForumDescription"]"/>
                        <button type="submit" class="btn btn-primary" asp-page-handler="SaveIndexBlock">保存</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-8 p-1 ">
            <div class="card p-3 bg-dark-subtle">
                
                <form method="post" asp-page-handler="SaveTogglesBlock">
                    <div class="d-flex gap-3 flex-wrap">
                        <div class="form-check form-switch">
                            
                            @if (Model.Config["UseBoardCreation"].ParseBool())
                            {
                                <input class="form-check-input" type="checkbox" id="UseBoardCreationToggle" checked asp-for="UseBoardCreation"/>

                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" id="UseBoardCreationToggle" asp-for="UseBoardCreation"/>

                            }
                            <label for="UseBoardCreationToggle">启用创建板块</label>
                        </div>
                        <div class="form-check form-switch">
                            @if (Model.Config["AllowUserCreateBoard"].ParseBool())
                            {
                                <input class="form-check-input" type="checkbox" id="AllowUserCreateBoard" checked asp-for="AllowUserCreateBoard"/>
                                
                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" id="AllowUserCreateBoard" asp-for="AllowUserCreateBoard"/>
                                
                            }
                            <label for="AllowUserCreateBoard">启用用户创建板块</label>
                        </div>
                        <div class="form-check form-switch">
                            @if (Model.Config["AllowAnonymousPost"].ParseBool())
                            {
                                <input class="form-check-input" type="checkbox" id="AllowAnonymousPost" checked asp-for="AllowAnonymousPost"/>
                                
                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" id="AllowAnonymousPost" asp-for="AllowAnonymousPost"/>
                                
                            }
                            <label for="AllowAnonymousPost">启用匿名回复</label>
                        </div>
                        <div class="form-check form-switch">
                            @if (Model.Config["AllowAnonymousTopic"].ParseBool())
                            {
                                <input class="form-check-input" type="checkbox" id="AllowAnonymousTopic" checked asp-for="AllowAnonymousTopic"/>
                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" id="AllowAnonymousTopic" asp-for="AllowAnonymousTopic"/>
                                
                            }
                            <label for="AllowAnonymousTopic">启用匿名话题</label>
                            
                        </div>
                        <div class="form-check form-switch">
                            @if (Model.Config["AllowAnonymousBoard"].ParseBool())
                            {
                                <input class="form-check-input" type="checkbox" id="AllowAnonymousBoard" checked asp-for="AllowAnonymousBoard"/>
                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" id="AllowAnonymousBoard" asp-for="AllowAnonymousBoard"/>
                                
                            }
                            <label for="AllowAnonymousPost">启用匿名版块</label>
                            
                        </div>
                        <div class="form-check form-switch">
                            @if (Model.Config["ShowButtonWhenFeatureDisabled"].ParseBool())
                            {
                            <input class="form-check-input" type="checkbox" id="ShowButtonWhenFeatureDisabled" checked asp-for="ShowButtonWhenFeatureDisabled"/>
                                
                            }
                            else
                            {
                            <input class="form-check-input" type="checkbox" id="ShowButtonWhenFeatureDisabled"  asp-for="ShowButtonWhenFeatureDisabled"/>
                                
                            }
                            <label for="AllowAnonymousPost">功能不开启时显示按钮</label>
                            
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">保存</button>
                </form>
                
                   
                
            </div>
        </div>
    </div>
</div>

<partial name="Validation"/>